{
  "devDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "hospice-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:generate": "turbo run db:generate",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.4",
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "zod": "4.6.5"
  }
}
