# Copy to apps/api/.env and fill in. NEVER commit a real .env.
# The Telnyx API key lives ONLY here (server-side). It must never appear in
# mobile/web bundles, logs, or chat transcripts.

# Telnyx API key (server-side only — apps/api reads process.env.TELNYX_API_KEY)
TELNYX_API_KEY=
# Telnyx phone number used as the SMS sender (E.164, e.g. +12692905396)
TELNYX_FROM_NUMBER=

# PostgreSQL connection string for apps/api + packages/db
DATABASE_URL=postgres://hospice:hospice@localhost:5432/hospice

# Public base URL of the NestJS API, used by web/mobile clients
API_BASE_URL=http://localhost:3001
